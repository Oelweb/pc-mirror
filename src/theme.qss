QWidget { color: #FFFFFF; font-family: 'Segoe UI Variable'; font-size: 14px; }
QMainWindow, QDialog, QScrollArea, #mainWindow, #idlePage, #stage { background: #1C1C1C; }
QLabel { background: transparent; }
#instruction { font-size: 14px; }
#status, #secondary { color: #A0A0A0; font-size: 12px; }
#pin { color: #FFFFFF; font-size: 18px; }
#videoSurface { background: #000000; }
#settingRow { background: #262626; border: 1px solid #333333; border-radius: 8px; }
#settingRow QLabel { border: none; }
#playbackToolbar, #updateBanner, #errorBanner { background: #262626; border: 1px solid #333333; border-radius: 8px; }
#errorText { color: #C87878; }
#notice { color: #A0A0A0; font-size: 12px; padding: 8px; }
QPushButton { background: #262626; border: 1px solid #333333; border-radius: 8px; padding: 8px 16px; min-height: 24px; }
QPushButton:hover { background: #333333; }
QPushButton:pressed { background: #1C1C1C; }
QPushButton:focus { border-color: #A0A0A0; }
QPushButton:disabled { color: #A0A0A0; }
QPushButton:checked { background: #2F7BFF; }
#primaryButton { background: #2F7BFF; border: 1px solid #2F7BFF; color: #FFFFFF; }
#primaryButton:disabled { background: #333333; border-color: #333333; color: #A0A0A0; }
#iconButton { padding: 0; min-height: 0; background: transparent; border-color: transparent; }
#iconButton:hover { background: #333333; }
#iconButton:checked { background: #2F7BFF; }
#subtleButton { border-color: transparent; }
QLineEdit, QComboBox, QPlainTextEdit { background: #1C1C1C; color: #FFFFFF; border: 1px solid #333333; border-radius: 8px; padding: 8px; selection-background-color: #2F7BFF; }
QLineEdit:focus, QComboBox:focus { border-color: #2F7BFF; }
QComboBox { min-height: 24px; padding-right: 40px; }
QComboBox:hover { border-color: #555555; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 32px; border: none; }
QComboBox::down-arrow { image: url(:/chevron-down.png); width: 16px; height: 16px; }
QComboBox QAbstractItemView { background: #262626; color: #FFFFFF; border: 1px solid #333333; border-radius: 8px; padding: 4px; outline: none; selection-background-color: #333333; selection-color: #FFFFFF; }
QComboBox QAbstractItemView::item { min-height: 32px; padding: 4px 12px; border: none; border-radius: 8px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected { background: #333333; color: #FFFFFF; }
QPlainTextEdit { font-size: 12px; }
QScrollBar:vertical { background: #1C1C1C; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #333333; border-radius: 4px; min-height: 32px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { color: #FFFFFF; background: #262626; border: 1px solid #333333; padding: 8px; }
