// SPDX-License-Identifier: GPL-3.0-or-later
// PC-Mirror – native Oberfläche. Texte sind deutsche Quelltexte; T.t() übersetzt
// sie zur Laufzeit. T.lang ist Parameter, damit ein Sprachwechsel alle Texte neu bindet.
import { ComboBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";

export global T {
    in property <string> lang: "de";
    pure callback t(string, string) -> string;
}

export global Theme {
    out property <color> bg: #1C1C1C;
    out property <color> surface: #262626;
    out property <color> line: #333333;
    out property <color> text: #FFFFFF;
    out property <color> muted: #A0A0A0;
    out property <color> accent: #2F7BFF;
    out property <color> error: #C87878;
    out property <color> waiting: #C1A55B;
    out property <color> ok: #6FA77B;
}

export global Icons {
    out property <string> mirror: "M5 4h9a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M10 9h9a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z";
    out property <string> fullscreen: "M4 9V4h5 M15 4h5v5 M20 15v5h-5 M9 20H4v-5";
    out property <string> screenshot: "M5 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z M8 7l1-3h6l1 3 M15.5 13.5a3.5 3.5 0 1 1-7 0a3.5 3.5 0 1 1 7 0z";
    out property <string> volume: "M3 9h4l5-4v14l-5-4H3z M15 9.5a3.5 3.5 0 0 1 0 5 M17.5 6.5a7.5 7.5 0 0 1 0 11";
    out property <string> muted: "M3 9h4l5-4v14l-5-4H3z M16 9l5 6 M21 9l-5 6";
    out property <string> disconnect: "M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z";
    out property <string> settings: "M18.5 12a6.5 6.5 0 1 1-13 0a6.5 6.5 0 1 1 13 0z M14.5 12a2.5 2.5 0 1 1-5 0a2.5 2.5 0 1 1 5 0z M12 5.5V3 M12 21v-2.5 M5.5 12H3 M21 12h-2.5 M7.4 7.4L5.6 5.6 M18.4 18.4l-1.8-1.8 M16.6 7.4l1.8-1.8 M5.6 18.4l1.8-1.8";
    out property <string> help: "M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0z M12 11v6 M12 7v0.01";
    out property <string> close: "M6 6l12 12 M18 6L6 18";
}

component Icon inherits Path {
    in property <string> data;
    in property <color> tint: Theme.text;
    commands: data;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: transparent;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: root.checked ? Theme.accent : (touch.has-hover && root.enabled ? Theme.line : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Icon {
        width: 20px;
        height: 20px;
        data: root.icon;
        tint: root.enabled ? Theme.text : Theme.muted;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Hauptaktion in festem Blau #2F7BFF statt der Windows-Akzentfarbe.
// Einheitlicher Button: gleiche Höhe und Form für Haupt- und Nebenaktionen,
// feste Farben statt der Windows-Akzentfarbe.
component PushButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    callback clicked();
    min-width: label.preferred-width + 32px;
    min-height: 36px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    face := Rectangle {
        y: (root.height - self.height) / 2;
        height: 36px;
        border-radius: 6px;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? #FFFFFF : (root.primary && root.enabled ? Theme.accent : Theme.line);
        background: !root.enabled ? Theme.surface
            : root.primary ? (touch.pressed ? #2563D6 : (touch.has-hover ? #4A8DFF : Theme.accent))
            : (touch.pressed ? Theme.bg : (touch.has-hover ? Theme.line : Theme.surface));
        animate background { duration: 100ms; }
        label := Text {
            text: root.text;
            color: root.enabled ? #FFFFFF : Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    // Fokusbereich liegt unter der Klickfläche: sonst schluckt er den ersten Klick
    // (nur Fokus, weißer Rand) und erst der zweite Klick löst aus.
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
}

// Statuszeile mit farbigem Punkt: 0 = wird geprüft, 1 = in Ordnung, 2 = Handlungsbedarf.
component StatusLine inherits HorizontalLayout {
    in property <int> state;
    in property <string> text;
    spacing: 10px;
    alignment: start;
    Rectangle {
        width: 10px;
        height: 10px;
        y: 6px;
        border-radius: 5px;
        background: root.state == 1 ? Theme.ok : (root.state == 2 ? Theme.waiting : Theme.muted);
    }
    Text {
        text: root.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
        color: root.state == 2 ? Theme.waiting : Theme.text;
    }
}

// Schalter wie in der früheren Oberfläche: blau, wenn aktiv.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 40px;
    min-height: 24px;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }
    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    track := Rectangle {
        y: (root.height - self.height) / 2;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? Theme.accent : Theme.line;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? #FFFFFF : Theme.line;
        animate background { duration: 150ms; }
    }
    Rectangle {
        x: root.checked ? 23px : 3px;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #FFFFFF;
        animate x { duration: 150ms; easing: ease-in-out; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.flip();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
}

component Banner inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 8px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <color> hint-color: Theme.muted;
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 8px;
    min-height: 56px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                wrap: word-wrap;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: root.hint-color;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// Einrichtungsassistent direkt im Hauptfenster (kein eigenes Fenster).
component OnboardingPanel inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 12px;
    // Feste Höhe: umbrechender Text würde sonst zu niedrig berechnet.
    height: 440px;

    in-out property <int> page;
    in property <string> device-name;
    in property <string> network;
    in property <int> network-state;
    in property <string> network-text;
    in property <int> firewall-state;
    in property <string> firewall-text;
    callback configure-firewall();
    callback recheck();
    callback open-network-settings();
    callback finish();

    content := VerticalLayout {
        padding: 32px;
        spacing: 20px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for index in 4: Rectangle {
                width: index == root.page ? 28px : 8px;
                height: 8px;
                border-radius: 4px;
                background: index <= root.page ? Theme.accent : Theme.line;
                animate width { duration: 150ms; }
            }
        }

        if root.page == 0: VerticalLayout {
            spacing: 16px;
            Icon {
                width: 56px;
                height: 56px;
                data: Icons.mirror;
                tint: Theme.accent;
                stroke-width: 2px;
            }
            Text {
                text: T.t("Willkommen bei PC-Mirror", T.lang);
                font-size: 22px;
                font-weight: 600;
            }
            Text {
                text: T.t("Spiegle den Bildschirm deines iPhones oder iPads mit Ton auf diesen PC. In drei kurzen Schritten ist alles bereit: Netzwerk prüfen, Firewall freigeben, verbinden.", T.lang);
                color: Theme.muted;
                wrap: word-wrap;
            }
        }

        if root.page == 1: VerticalLayout {
            spacing: 14px;
            Text {
                text: T.t("Schritt 1: Netzwerk", T.lang);
                font-size: 20px;
                font-weight: 600;
            }
            Text {
                text: T.t("PC und iPhone/iPad müssen mit demselben Router verbunden sein. Ethernet am PC ist erlaubt. Gastnetz, VPN und AP-Isolation können die Verbindung blockieren.", T.lang);
                color: Theme.muted;
                wrap: word-wrap;
            }
            StatusLine {
                state: root.network-state;
                text: root.network-text;
            }
            Text {
                text: root.network;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.network-state == 2: HorizontalLayout {
                alignment: start;
                PushButton {
                    primary: true;
                    text: T.t("Als Heimnetz einstufen", T.lang);
                    clicked => { root.open-network-settings(); }
                }
            }
        }

        if root.page == 2: VerticalLayout {
            spacing: 14px;
            Text {
                text: T.t("Schritt 2: Firewall", T.lang);
                font-size: 20px;
                font-weight: 600;
            }
            Text {
                text: T.t("Damit dein iPhone PC-Mirror findet, braucht Windows eine Freigabe – nur für dieses Programm und nur im privaten Heimnetz. Windows fragt dabei nach Administratorrechten.", T.lang);
                color: Theme.muted;
                wrap: word-wrap;
            }
            StatusLine {
                state: root.firewall-state;
                text: root.firewall-text;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.firewall-state != 1: PushButton {
                    primary: true;
                    text: T.t("Firewall einrichten", T.lang);
                    clicked => { root.configure-firewall(); }
                }
                PushButton {
                    text: T.t("Erneut prüfen", T.lang);
                    clicked => { root.recheck(); }
                }
            }
        }

        if root.page == 3: VerticalLayout {
            spacing: 14px;
            Text {
                text: T.t("Schritt 3: Verbinden", T.lang);
                font-size: 20px;
                font-weight: 600;
            }
            Text {
                text: "1.  " + T.t("Am iPhone oder iPad das Kontrollzentrum öffnen (oben rechts nach unten wischen).", T.lang);
                wrap: word-wrap;
            }
            Text {
                text: "2.  " + T.t("„Bildschirmsynchronisierung“ antippen.", T.lang);
                wrap: word-wrap;
            }
            Text {
                text: "3.  " + T.t("Diesen PC auswählen:", T.lang) + " " + root.device-name;
                wrap: word-wrap;
            }
            Text {
                text: T.t("Tipp: Einstellungen jederzeit mit Strg+, öffnen. Den Assistenten findest du dort unter „Verbindung“.", T.lang);
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 8px;
            if root.page < 3: PushButton {
                text: T.t("Überspringen", T.lang);
                clicked => { root.finish(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.page > 0: PushButton {
                text: T.t("Zurück", T.lang);
                clicked => { root.page -= 1; }
            }
            PushButton {
                primary: true;
                text: root.page == 3 ? T.t("Fertig", T.lang) : T.t("Weiter", T.lang);
                clicked => {
                    if (root.page == 3) {
                        root.finish();
                    } else {
                        root.page += 1;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "PC-Mirror";
    icon: @image-url("../../../assets/icon-256.png");
    background: Theme.bg;
    preferred-width: 1008px;
    preferred-height: 672px;
    min-width: 720px;
    min-height: 480px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in property <bool> streaming;
    in property <string> device-line;
    in property <string> status-text;
    in property <color> status-color: Theme.muted;
    in property <string> pin-text;
    in property <bool> error-visible;
    in property <string> error-text;
    in property <string> error-action-text;
    in property <bool> update-visible;
    in property <string> update-text;
    in property <bool> can-install;
    in property <bool> can-later: true;
    in property <string> notice-text;
    in property <bool> onboarding-visible;
    in-out property <int> onboarding-page;
    in property <string> onboarding-device;
    in property <string> onboarding-network;
    in property <int> onboarding-network-state;
    in property <string> onboarding-network-text;
    in property <int> onboarding-firewall-state;
    in property <string> onboarding-firewall-text;
    out property <length> stage-x: stage.absolute-position.x;
    out property <length> stage-y: stage.absolute-position.y;
    out property <length> stage-width: stage.width;
    out property <length> stage-height: stage.height;

    callback open-settings();
    callback show-diagnostics();
    callback restart();
    callback error-action();
    callback dismiss-error();
    callback install-update();
    callback later-update();
    callback toggle-fullscreen();
    callback leave-fullscreen();
    callback onboarding-configure-firewall();
    callback onboarding-recheck();
    callback onboarding-network-settings();
    callback onboarding-finish();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.F11) {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.leave-fullscreen();
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.open-settings();
                return accept;
            }
            reject
        }

        VerticalLayout {
            if root.error-visible: Banner {
                Text {
                    text: root.error-text;
                    color: Theme.error;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                PushButton {
                    text: T.t("Diagnose", T.lang);
                    clicked => { root.show-diagnostics(); }
                }
                PushButton {
                    primary: true;
                    text: root.error-action-text;
                    clicked => { root.error-action(); }
                }
                IconButton {
                    icon: Icons.close;
                    label: T.t("Hinweis schließen", T.lang);
                    clicked => { root.dismiss-error(); }
                }
            }
            if root.update-visible: Banner {
                Text {
                    text: root.update-text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                PushButton {
                    primary: true;
                    text: T.t("Jetzt installieren", T.lang);
                    enabled: root.can-install;
                    clicked => { root.install-update(); }
                }
                PushButton {
                    text: T.t("Später", T.lang);
                    enabled: root.can-later;
                    clicked => { root.later-update(); }
                }
            }
            stage := Rectangle {
                vertical-stretch: 1;
                background: root.streaming ? #000000 : Theme.bg;
                if !root.streaming && root.onboarding-visible: VerticalLayout {
                    padding: 24px;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        OnboardingPanel {
                            width: 600px;
                            page <=> root.onboarding-page;
                            device-name: root.onboarding-device;
                            network: root.onboarding-network;
                            network-state: root.onboarding-network-state;
                            network-text: root.onboarding-network-text;
                            firewall-state: root.onboarding-firewall-state;
                            firewall-text: root.onboarding-firewall-text;
                            configure-firewall => { root.onboarding-configure-firewall(); }
                            recheck => { root.onboarding-recheck(); }
                            open-network-settings => { root.onboarding-network-settings(); }
                            finish => { root.onboarding-finish(); }
                        }
                    }
                }
                if !root.streaming && !root.onboarding-visible: VerticalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-top: 16px;
                    padding-bottom: 32px;
                    spacing: 16px;
                    HorizontalLayout {
                        alignment: end;
                        IconButton {
                            icon: Icons.settings;
                            label: T.t("Einstellungen", T.lang);
                            clicked => { root.open-settings(); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            width: 48px;
                            height: 48px;
                            data: Icons.mirror;
                            tint: Theme.muted;
                            stroke-width: 2px;
                        }
                    }
                    Text {
                        text: root.device-line;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.status-text;
                        color: root.status-color;
                        font-size: 12px;
                        horizontal-alignment: center;
                        accessible-role: text;
                    }
                    if root.pin-text != "": Text {
                        text: root.pin-text;
                        font-size: 18px;
                        horizontal-alignment: center;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 40px; }
                }
            }
            if root.notice-text != "": Text {
                text: root.notice-text;
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                height: 32px;
                vertical-alignment: center;
            }
        }
    }
}

export component ToolbarWindow inherits Window {
    no-frame: true;
    title: "PC-Mirror";
    // Wechselt bei jedem Einblenden um eine unsichtbare Nuance, damit die ganze
    // Leiste neu gezeichnet wird (siehe update_toolbar in app.rs).
    in property <bool> repaint-phase;
    background: root.repaint-phase ? #262627 : Theme.surface;
    width: 200px;
    height: 56px;
    default-font-family: "Segoe UI";

    in property <bool> muted;
    in property <bool> can-shoot;
    in property <bool> can-disconnect;
    callback fullscreen();
    callback screenshot();
    callback toggle-mute();
    callback disconnect();
    callback pointer-activity();

    TouchArea {
        moved => { root.pointer-activity(); }
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        IconButton {
            icon: Icons.fullscreen;
            label: T.t("Vollbild (F11)", T.lang);
            clicked => { root.fullscreen(); }
        }
        IconButton {
            icon: Icons.screenshot;
            label: T.t("Screenshot speichern", T.lang);
            enabled: root.can-shoot;
            clicked => { root.screenshot(); }
        }
        IconButton {
            icon: root.muted ? Icons.muted : Icons.volume;
            label: root.muted ? T.t("Ton einschalten", T.lang) : T.t("Ton ausschalten", T.lang);
            checked: root.muted;
            clicked => { root.toggle-mute(); }
        }
        IconButton {
            icon: Icons.disconnect;
            label: T.t("Verbindung trennen", T.lang);
            enabled: root.can-disconnect;
            clicked => { root.disconnect(); }
        }
    }
}

export component SettingsWindow inherits Window {
    title: T.t("Einstellungen", T.lang);
    icon: @image-url("../../../assets/icon-256.png");
    background: Theme.bg;
    preferred-width: 664px;
    preferred-height: 760px;
    min-width: 600px;
    min-height: 560px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in-out property <int> language-index;
    in-out property <string> device-name;
    in-out property <int> quality-index: 1;
    in-out property <bool> ipad-fill;
    in-out property <bool> topmost;
    in-out property <bool> autostart;
    in-out property <bool> pin-enabled;
    in-out property <string> pin;
    in-out property <bool> software-decoder;
    in-out property <bool> automatic-updates: true;
    in property <string> version-text;
    in property <string> update-status;
    in property <bool> can-check: true;
    in property <string> validation;
    in property <string> firewall-status;
    in property <int> firewall-state;
    property <bool> help-visible;

    callback language-selected(int);
    callback check-updates();
    callback save();
    callback cancel();
    callback show-diagnostics();
    callback configure-firewall();
    callback start-onboarding();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-right: 14px;
                spacing: 8px;
                alignment: start;

                SectionTitle { text: T.t("Allgemein", T.lang); }
                SettingRow {
                    label: T.t("Sprache", T.lang);
                    ComboBox {
                        width: 240px;
                        model: ["Deutsch", "English"];
                        current-index <=> root.language-index;
                        accessible-label: T.t("Sprache", T.lang);
                        selected => { root.language-selected(self.current-index); }
                    }
                }
                SettingRow {
                    label: T.t("Gerätename", T.lang);
                    hint: T.t("So erscheint der PC am iPhone.", T.lang);
                    LineEdit {
                        width: 240px;
                        text <=> root.device-name;
                        accessible-label: T.t("Gerätename", T.lang);
                    }
                }
                SettingRow {
                    label: T.t("Mit Windows starten", T.lang);
                    Toggle {
                        checked <=> root.autostart;
                        label: T.t("Mit Windows starten", T.lang);
                    }
                }
                SettingRow {
                    label: T.t("Immer im Vordergrund", T.lang);
                    Toggle {
                        checked <=> root.topmost;
                        label: T.t("Immer im Vordergrund", T.lang);
                    }
                }

                SectionTitle { text: T.t("Bild und Ton", T.lang); }
                SettingRow {
                    label: T.t("Qualität", T.lang);
                    hint: T.t("Bei Ruckeln 720p wählen.", T.lang);
                    ComboBox {
                        width: 240px;
                        model: ["720p · 30 FPS", "1080p · 60 FPS", T.t("4K · 60 FPS (experimentell)", T.lang)];
                        current-index <=> root.quality-index;
                        accessible-label: T.t("Qualität", T.lang);
                    }
                }
                SettingRow {
                    label: T.t("iPad: Fenster ausfüllen", T.lang);
                    hint: T.t("Nur beim iPad. Ohne Balken, dafür können Bildränder fehlen. Aus: ganzes Bild.", T.lang);
                    Toggle {
                        checked <=> root.ipad-fill;
                        label: T.t("iPad: Fenster ausfüllen", T.lang);
                    }
                }
                SettingRow {
                    label: T.t("Software-Decodierung", T.lang);
                    hint: T.t("Hilft bei schwarzem Bild mit älteren Grafiktreibern.", T.lang);
                    Toggle {
                        checked <=> root.software-decoder;
                        label: T.t("Software-Decodierung", T.lang);
                    }
                }

                SectionTitle { text: T.t("Sicherheit", T.lang); }
                SettingRow {
                    label: T.t("PIN-Schutz", T.lang);
                    hint: T.t("Das iPhone muss beim Verbinden einen Code eingeben.", T.lang);
                    Toggle {
                        checked <=> root.pin-enabled;
                        label: T.t("PIN-Schutz", T.lang);
                    }
                }
                if root.pin-enabled: SettingRow {
                    label: "PIN";
                    LineEdit {
                        width: 240px;
                        text <=> root.pin;
                        input-type: number;
                        placeholder-text: T.t("Leer = zufälliger Code", T.lang);
                        accessible-label: "PIN";
                    }
                }

                SectionTitle { text: T.t("Verbindung", T.lang); }
                SettingRow {
                    label: T.t("Firewall und Netzwerk", T.lang);
                    hint: root.firewall-status;
                    hint-color: root.firewall-state == 1 ? Theme.ok : (root.firewall-state == 2 ? Theme.waiting : Theme.muted);
                    PushButton {
                        primary: root.firewall-state == 2;
                        text: T.t("Firewall einrichten", T.lang);
                        clicked => { root.configure-firewall(); }
                    }
                }
                SettingRow {
                    label: T.t("Einrichtungsassistent", T.lang);
                    hint: T.t("Netzwerk, Firewall und Verbinden Schritt für Schritt.", T.lang);
                    PushButton {
                        text: T.t("Starten", T.lang);
                        clicked => { root.start-onboarding(); }
                    }
                }
                SettingRow {
                    label: T.t("Diagnose", T.lang);
                    hint: T.t("Netzwerkadapter, Firewall-Prüfung und Protokoll.", T.lang);
                    PushButton {
                        text: T.t("Öffnen", T.lang);
                        clicked => { root.show-diagnostics(); }
                    }
                }

                SectionTitle { text: T.t("Updates", T.lang); }
                SettingRow {
                    label: root.version-text;
                    hint: root.update-status;
                    PushButton {
                        text: T.t("Nach Updates suchen", T.lang);
                        enabled: root.can-check;
                        clicked => { root.check-updates(); }
                    }
                }
                SettingRow {
                    label: T.t("Automatisch nach Updates suchen", T.lang);
                    Toggle {
                        checked <=> root.automatic-updates;
                        label: T.t("Automatisch nach Updates suchen", T.lang);
                    }
                }

                SectionTitle { text: T.t("Hilfe", T.lang); }
                SettingRow {
                    label: T.t("Mitteilungen beim Spiegeln", T.lang);
                    hint: T.t("Am iPhone ein- oder ausschalten.", T.lang);
                    PushButton {
                        text: root.help-visible ? T.t("Anleitung ausblenden", T.lang) : T.t("Anleitung anzeigen", T.lang);
                        clicked => { root.help-visible = !root.help-visible; }
                    }
                }
                if root.help-visible: Text {
                    text: T.t("Am iPhone: Einstellungen → Mitteilungen → Bildschirmfreigabe → Mitteilungen erlauben.\n\nDort Mitteilungen ein- oder ausschalten. Der Menüpunkt hängt von der iOS-Version ab. Fokus und die Mitteilungseinstellungen der jeweiligen App gelten weiterhin.\n\nPC-Mirror kann diese iPhone-Einstellung nicht ändern.", T.lang);
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        if root.validation != "": Text {
            text: root.validation;
            color: Theme.error;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            PushButton {
                text: T.t("Abbrechen", T.lang);
                clicked => { root.cancel(); }
            }
            PushButton {
                primary: true;
                text: T.t("Speichern", T.lang);
                clicked => { root.save(); }
            }
        }
    }
}


export component DiagnosticsWindow inherits Window {
    title: T.t("Diagnose & Hilfe · PC-Mirror", T.lang);
    icon: @image-url("../../../assets/icon-256.png");
    background: Theme.bg;
    preferred-width: 800px;
    preferred-height: 640px;
    min-width: 560px;
    min-height: 480px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in property <string> network;
    in property <string> firewall-status;
    in property <string> log-text;
    callback configure-firewall();
    callback recheck();
    callback open-logs();
    callback close-clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text {
            text: root.network;
            color: Theme.muted;
            wrap: word-wrap;
        }
        Text {
            text: T.t("mDNS: in UxPlay integriert · Bonjour ist nicht erforderlich\nAirPlay: TCP/UDP 48000–48002 · Discovery: UDP 5353\nFirewall-Freigaben gelten nur im privaten lokalen Netz.", T.lang);
            color: Theme.muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            PushButton {
                primary: true;
                text: T.t("Firewall einrichten", T.lang);
                clicked => { root.configure-firewall(); }
            }
            PushButton {
                text: T.t("Erneut prüfen", T.lang);
                clicked => { root.recheck(); }
            }
            PushButton {
                text: T.t("Logordner öffnen", T.lang);
                clicked => { root.open-logs(); }
            }
        }
        Text {
            text: root.firewall-status;
            color: Theme.muted;
            wrap: word-wrap;
        }
        Text {
            text: T.t("Nicht sichtbar: gleiches Netz, Profil Privat, VPN/Gastnetz/AP-Isolation prüfen.\nSchwarzes Bild: Home-Bildschirm testen; geschützte Inhalte können gesperrt sein.\nKein Ton: Windows-Ausgabe und Lautstärkemixer prüfen.\nRuckeln: 720p/30 FPS wählen, PC per Ethernet anbinden.\nMehr Hilfe: README im Installationsordner.", T.lang);
            color: Theme.muted;
            wrap: word-wrap;
        }
        Text {
            text: T.t("Protokoll (neueste Einträge oben)", T.lang);
            font-size: 12px;
        }
        TextEdit {
            vertical-stretch: 1;
            read-only: true;
            font-size: 12px;
            text: root.log-text;
        }
        HorizontalLayout {
            alignment: end;
            PushButton {
                text: T.t("Schließen", T.lang);
                clicked => { root.close-clicked(); }
            }
        }
    }
}
